{
  "hooks": ["guard", "no-dialogs", "no-side-channels"],
  "guard": "readonly",
  "work_dir": "work",
  "settings": {
    "worktree": { "bgIsolation": "none" },
    "permissions": {
      "deny": [
        "Bash(> *)",
        "Bash(chmod *)",
        "Bash(composer *)",
        "Bash(cp *)",
        "Bash(dart *)",
        "Bash(docker *)",
        "Bash(flutter *)",
        "Bash(gh pr close *)",
        "Bash(gh pr merge *)",
        "Bash(gh pr ready *)",
        "Bash(git -C * add *)",
        "Bash(git -C * checkout *)",
        "Bash(git -C * commit *)",
        "Bash(git -C * merge *)",
        "Bash(git -C * mv *)",
        "Bash(git -C * push *)",
        "Bash(git -C * rebase *)",
        "Bash(git -C * reset *)",
        "Bash(git -C * rm *)",
        "Bash(git -C * stash *)",
        "Bash(git -C * switch *)",
        "Bash(git -C * tag *)",
        "Bash(git -C * worktree *)",
        "Bash(git checkout *)",
        "Bash(git commit *)",
        "Bash(git merge *)",
        "Bash(git push *)",
        "Bash(git rebase *)",
        "Bash(git reset *)",
        "Bash(git stash *)",
        "Bash(git switch *)",
        "Bash(git worktree *)",
        "Bash(mv *)",
        "Bash(node *)",
        "Bash(npm *)",
        "Bash(php *)",
        "Bash(python3 *)",
        "Bash(rm *)",
        "Bash(sed -i *)",
        "Bash(tee *)",
        "Bash(yarn *)",
        "EnterPlanMode",
        "ExitPlanMode",
        "NotebookEdit"
      ],
      "allow": [
        "Bash(git -C * fetch *)",
        "Bash(git -C * log *)",
        "Bash(git -C * diff *)",
        "Bash(git -C * show *)",
        "Bash(git -C * cherry *)",
        "Bash(git -C * rev-parse *)",
        "Bash(git -C * branch *)",
        "Bash(git -C * status *)",
        "Bash(gh pr view *)",
        "Bash(gh pr diff *)",
        "Bash(gh api repos/{org}/*)",
        "Bash(git -c url.https://github.com/.insteadOf=git@github.com: -C * fetch *)",
        "Bash(git -C * -c url.https://github.com/.insteadOf=git@github.com: fetch *)",
        "Artifact",
        "ArtifactComments",
        "DesignSync",
        "Skill",
        "mcp__playwright__*",
        "mcp__claude_ai_Figma__get_design_context",
        "mcp__claude_ai_Figma__get_metadata",
        "mcp__claude_ai_Figma__get_screenshot"
      ]
    }
  }
}
